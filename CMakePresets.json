{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "HELLO_BUILD_TESTS": "ON",
        "HELLO_BUILD_EXAMPLES": "ON",
        "HELLO_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Host: Debug",
      "description": "Plain debug build on the host: tests and examples on, warnings as errors.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Host: Release",
      "description": "Optimized host build, tests and examples on.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "displayName": "Host: ASan + UBSan",
      "description": "Host debug build instrumented with AddressSanitizer and UndefinedBehaviorSanitizer.",
      "inherits": "debug",
      "cacheVariables": {
        "HELLO_SANITIZER": "address;undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "Host: TSan",
      "description": "Host debug build instrumented with ThreadSanitizer.",
      "inherits": "debug",
      "cacheVariables": {
        "HELLO_SANITIZER": "thread"
      }
    },
    {
      "name": "coverage",
      "displayName": "Host: Coverage",
      "description": "Host debug build instrumented with --coverage; 'coverage' target runs ctest + gcovr.",
      "inherits": "debug",
      "cacheVariables": {
        "HELLO_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "tidy",
      "displayName": "Host: clang-tidy",
      "description": "Host debug build with clang-tidy running on the hello target.",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "HELLO_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "cppcheck",
      "displayName": "Host: cppcheck",
      "description": "Host debug build with cppcheck running on the hello target.",
      "inherits": "debug",
      "cacheVariables": {
        "HELLO_ENABLE_CPPCHECK": "ON"
      }
    },
    {
      "name": "vx-base",
      "hidden": true,
      "inherits": "base",
      "description": "VxWorks build. Finds VxWorks through WIND_HOME (the SDK directory) or, for a full installation, WIND_CC_SYSROOT (a VSB). Set them in the shell or in CMakeUserPresets.json (see CMakeUserPresets.json.example).",
      "toolchainFile": "${sourceDir}/cmake/toolchains/vxworks.cmake",
      "cacheVariables": {
        "VX_TARGET_TYPE": "RTP",
        "HELLO_BUILD_DOCS": "OFF"
      }
    },
    {
      "name": "vx-rtp-debug",
      "displayName": "VxWorks RTP: Debug",
      "description": "Real Time Process (.vxe) debug build; ctest runs the tests in QEMU.",
      "inherits": "vx-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "vx-rtp-release",
      "displayName": "VxWorks RTP: Release",
      "description": "Optimized Real Time Process (.vxe) build.",
      "inherits": "vx-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "vx-rtp-shared",
      "displayName": "VxWorks RTP: shared library",
      "description": "RTP debug build with hello as a shared library (libhello.so), loaded at run time.",
      "inherits": "vx-rtp-debug",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "vx-rtp-ubsan",
      "displayName": "VxWorks RTP: UBSan (trap mode)",
      "description": "RTP debug build with UndefinedBehaviorSanitizer in trap mode (the SDK has no sanitizer runtime).",
      "inherits": "vx-rtp-debug",
      "cacheVariables": {
        "HELLO_SANITIZER": "undefined"
      }
    },
    {
      "name": "vx-dkm",
      "displayName": "VxWorks DKM: Debug",
      "description": "Downloadable kernel module (.out) build; ctest loads it in QEMU and calls its self-test.",
      "inherits": "vx-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VX_TARGET_TYPE": "DKM"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "tidy",
      "configurePreset": "tidy"
    },
    {
      "name": "cppcheck",
      "configurePreset": "cppcheck"
    },
    {
      "name": "vx-rtp-debug",
      "configurePreset": "vx-rtp-debug"
    },
    {
      "name": "vx-rtp-release",
      "configurePreset": "vx-rtp-release"
    },
    {
      "name": "vx-rtp-shared",
      "configurePreset": "vx-rtp-shared"
    },
    {
      "name": "vx-rtp-ubsan",
      "configurePreset": "vx-rtp-ubsan"
    },
    {
      "name": "vx-dkm",
      "configurePreset": "vx-dkm"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4,
        "stopOnFailure": false
      }
    },
    {
      "name": "vx-base",
      "hidden": true,
      "inherits": "base",
      "description": "Each test boots VxWorks in QEMU (a few seconds each, about 2 GB of guest memory).",
      "execution": {
        "jobs": 2,
        "timeout": 600
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "inherits": "base"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "inherits": "base"
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "inherits": "base"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "inherits": "base"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "inherits": "base"
    },
    {
      "name": "tidy",
      "configurePreset": "tidy",
      "inherits": "base"
    },
    {
      "name": "cppcheck",
      "configurePreset": "cppcheck",
      "inherits": "base"
    },
    {
      "name": "vx-rtp-debug",
      "configurePreset": "vx-rtp-debug",
      "inherits": "vx-base"
    },
    {
      "name": "vx-rtp-release",
      "configurePreset": "vx-rtp-release",
      "inherits": "vx-base"
    },
    {
      "name": "vx-rtp-shared",
      "configurePreset": "vx-rtp-shared",
      "inherits": "vx-base"
    },
    {
      "name": "vx-rtp-ubsan",
      "configurePreset": "vx-rtp-ubsan",
      "inherits": "vx-base"
    },
    {
      "name": "vx-dkm",
      "configurePreset": "vx-dkm",
      "inherits": "vx-base"
    }
  ]
}
